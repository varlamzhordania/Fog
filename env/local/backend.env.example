# Backend settings for local development.
# Database, Redis and Celery are wired automatically by docker-compose.local.yml.
DJANGO_ENV=local
DJANGO_SECRET_KEY=local-development-only-not-a-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=DEBUG
USE_HTTPS_IN_ABSOLUTE_URLS=False

# Public addresses as seen from the browser
SERVER_DOMAIN=localhost:8000
FRONTEND_DOMAIN=localhost:3000

# Emails are printed to the backend console while DJANGO_DEBUG=True.
DEFAULT_FROM_EMAIL=FOG Direct <noreply@localhost>
