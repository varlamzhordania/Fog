# Frontend settings for local development.
# Used by the browser:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used by the Next.js server inside the container:
INTERNAL_API_BASE_URL=http://backend:8000
NEXT_PUBLIC_MEDIA_BASE_URL=http://backend:8000
NEXT_PUBLIC_RESEARCH_URL=https://fleshofgod.org

# OAuth application credentials (create the application in /admin/ -> OAuth Applications)
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
