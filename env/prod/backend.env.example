# Backend secrets for production.
# Database, Redis, Celery, domains and DEBUG are set by docker-compose.prod.yml.
# Generate a key with: make secret
DJANGO_SECRET_KEY=
LOG_LEVEL=INFO

# Set to False only while running over plain HTTP (NGINX_MODE=http)
USE_HTTPS_IN_ABSOLUTE_URLS=True

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FOG Direct <orders@shop.example.com>
